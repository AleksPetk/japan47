# VPS production template. Copy this to the ignored root .env on the server,
# replace every secret placeholder, and never use localhost or a LAN address.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-at-least-50-cryptographically-random-characters
DJANGO_ADMIN_PATH=j47-management/
DJANGO_ALLOWED_HOSTS=japan47.alekspetk.com
CORS_ALLOWED_ORIGINS=https://japan47.alekspetk.com
CSRF_TRUSTED_ORIGINS=https://japan47.alekspetk.com

FRONTEND_URL=https://japan47.alekspetk.com
BACKEND_URL=https://japan47.alekspetk.com
VITE_PUBLIC_URL=https://japan47.alekspetk.com

POSTGRES_DB=japan47
POSTGRES_USER=japan47
POSTGRES_PASSWORD=replace-with-a-strong-production-password
HTTP_PORT=80

DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_COOKIES=True
DJANGO_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
API_ANON_THROTTLE=120/hour
API_USER_THROTTLE=1000/hour
AUTH_THROTTLE=10/minute
VERIFICATION_RESEND_THROTTLE=5/hour
PASSWORD_RESET_THROTTLE=5/hour
ACCOUNT_DELETION_THROTTLE=5/hour
ACCOUNT_EMAIL_COOLDOWN_SECONDS=60
SUPPORT_THROTTLE=5/hour
SUPPORT_DUPLICATE_MINUTES=10
CACHE_DEFAULT_TIMEOUT=300

# Secrets and provider credentials belong only in the VPS's ignored .env.
RESEND_API_KEY=replace-with-your-production-resend-api-key
DEFAULT_FROM_EMAIL=Japan47 <noreply@japan47.alekspetk.com>
EMAIL_VERIFICATION_TOKEN_MAX_AGE=86400
PASSWORD_RESET_TOKEN_MAX_AGE=3600
SERVER_EMAIL=server@japan47.alekspetk.com
ADMIN_EMAILS=admin@japan47.alekspetk.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
