# Local Docker only: Mac and phone testing on the same Wi-Fi.
# If this Mac's LAN IP changes, update every 192.168.0.206 value and restart
# Docker with: docker compose up -d --build
# VPS production must use .env.production.example and never use localhost.
DJANGO_SETTINGS_MODULE=config.settings.docker_local
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters-for-local-docker
DJANGO_ADMIN_PATH=j47-management/
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.206
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://192.168.0.206
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://192.168.0.206

# Nginx is Docker's only public entry point, so neither URL uses port 8000.
# These origins generate verification and password-reset links usable by phone.
FRONTEND_URL=http://192.168.0.206
BACKEND_URL=http://192.168.0.206
VITE_PUBLIC_URL=http://192.168.0.206

POSTGRES_DB=japan47
POSTGRES_USER=japan47
POSTGRES_PASSWORD=replace-with-a-strong-local-docker-password
HTTP_PORT=80

# Local Docker uses HTTP. Production must enable all secure values separately.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_COOKIES=False
DJANGO_HSTS_SECONDS=0
DJANGO_LOG_LEVEL=INFO

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
API_ANON_THROTTLE=120/hour
API_USER_THROTTLE=1000/hour
AUTH_THROTTLE=10/minute
VERIFICATION_RESEND_THROTTLE=5/hour
PASSWORD_RESET_THROTTLE=5/hour
ACCOUNT_DELETION_THROTTLE=5/hour
ACCOUNT_EMAIL_COOLDOWN_SECONDS=60
SUPPORT_THROTTLE=5/hour
SUPPORT_DUPLICATE_MINUTES=10
CACHE_DEFAULT_TIMEOUT=300

# Resend remains server-side. Replace the placeholder only in ignored .env.
RESEND_API_KEY=replace-with-your-local-resend-api-key
DEFAULT_FROM_EMAIL=Japan47 <noreply@japan47.alekspetk.com>
EMAIL_VERIFICATION_TOKEN_MAX_AGE=86400
PASSWORD_RESET_TOKEN_MAX_AGE=3600
SERVER_EMAIL=server@japan47.example
ADMIN_EMAILS=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
