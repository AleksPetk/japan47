# Local runserver/Vite only. Docker never reads backend/.env.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ADMIN_PATH=j47-management/
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Tokyo
DATABASE_URL=sqlite:///db.sqlite3
# Local development:
# Replace CURRENT_MAC_LOCAL_IP with this Mac's Wi-Fi/LAN IP so emailed links work on other devices.
# Production: change to https://japan47.alekspetk.com
# Never use localhost in production.
FRONTEND_URL=http://CURRENT_MAC_LOCAL_IP:5173

# Public Django/API origin.
# Replace CURRENT_MAC_LOCAL_IP with this Mac's Wi-Fi/LAN IP for local development.
# Production: change to https://japan47.alekspetk.com
# Never use localhost in production.
BACKEND_URL=http://CURRENT_MAC_LOCAL_IP:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
API_ANON_THROTTLE=120/hour
API_USER_THROTTLE=1000/hour
AUTH_THROTTLE=10/minute
VERIFICATION_RESEND_THROTTLE=5/hour
PASSWORD_RESET_THROTTLE=5/hour
ACCOUNT_DELETION_THROTTLE=5/hour
ACCOUNT_EMAIL_COOLDOWN_SECONDS=60
SUPPORT_THROTTLE=5/hour
SUPPORT_DUPLICATE_MINUTES=10
CACHE_DEFAULT_TIMEOUT=300
REDIS_URL=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Japan47 <noreply@japan47.alekspetk.com>
EMAIL_VERIFICATION_TOKEN_MAX_AGE=86400
PASSWORD_RESET_TOKEN_MAX_AGE=3600
SERVER_EMAIL=server@japan47.example
ADMIN_EMAILS=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DJANGO_LOG_LEVEL=INFO
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_COOKIES=False
DJANGO_HSTS_SECONDS=31536000
